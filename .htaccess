# ==============================================================================
# Harihar Ratna Emporium - Hostinger LiteSpeed Clean Configuration
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# Protect sensitive database and internal files
<FilesMatch "^(db_config\.php|schema\.sql|\.env|\.git|\.gitignore)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
